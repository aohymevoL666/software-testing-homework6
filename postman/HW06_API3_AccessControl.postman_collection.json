    "name": "HW06 API 3 - FR-12 Access Control",
    "description": "Executable suite for GET /api/admin/users with setup/login helpers. The suite intentionally keeps assertions that should fail when explicit FR-12/admin-only requirements are violated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const sid=pm.environment.get(\"studentId\") || \"23127531\";",
          "pm.request.headers.upsert({key:\"X-Student-Id\",value:sid});",
          "console.log(`[HW06] ${pm.info.requestName} | X-Student-Id: ${sid}`);"
        ]
      }
    }
  ],
