    {
      "name": "SETUP-00 - initialize unique normal user",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rid=Date.now().toString();",
              "pm.environment.set(\"runId\", rid);",
              "pm.environment.set(\"userEmail\", `hw06.admin.user.${rid}@example.com`);",
              "pm.environment.set(\"userPassword\", \"Password123!\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Backend reachable\", function(){ pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "SETUP-01 - login seeded admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@eshop.com\",\"password\":\"Admin123!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Seeded admin login succeeds\", function(){ pm.response.to.have.status(200); });",
              "const j=pm.response.json(); pm.environment.set(\"adminToken\", j.token); pm.environment.set(\"adminId\", j.user.id); pm.expect(j.user.role).to.equal(\"admin\");"
            ]
          }
        }
      ]
    },
